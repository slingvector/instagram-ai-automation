# N8N Webhook endpoint where to send scraped Instagram Reel URLs
N8N_WEBHOOK_URL="http://localhost:5678/webhook/your-webhook-id"

# The target DM inbox to scrape
TARGET_INSTAGRAM_CHAT_URL="https://www.instagram.com/direct/inbox/"

# Set to True to run the scraper invisibly, False to watch it (required for first login)
HEADLESS="False"

# (Optional) proxy server for the stealth scraper
# PROXY_SERVER="http://proxy-ip:port"
