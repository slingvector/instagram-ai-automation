# N8N Webhook endpoint where to send scraped Instagram Reel URLs
N8N_WEBHOOK_URL="http://localhost:5678/webhook/your-webhook-id"

# The target DM inbox to scrape
TARGET_INSTAGRAM_CHAT_URL="https://www.instagram.com/direct/inbox/"

# Set to True to run invisibly, False to watch it (required for first login)
HEADLESS="False"

# (Optional) proxy server for the stealth scraper
# USE_PROXY_FOR_INGESTION="true"
# PROXY_SERVER="http://proxy-ip:port"

# Google Cloud Configuration
GOOGLE_APPLICATION_CREDENTIALS="/path/to/your-service-account-key.json"
GCP_PROJECT_ID="your-gcp-project-id"
GCS_BUCKET_NAME="your-raw-input-bucket"
GCS_PROCESSED_BUCKET="your-processed-output-bucket"

# Publishing Edge — Appium / Android Device
APPIUM_HOST="http://localhost:4723"
DEVICE_UDID=""                          # blank = auto-detect
INSTAGRAM_PACKAGE="com.instagram.android"
FIRESTORE_POLL_INTERVAL_SECONDS="30"
HUMAN_REVIEW_ENABLED="true"
REVIEW_TIMEOUT_MINUTES="10"

# ── Ingestion Layer — Read-Only Instagram Account (DM scraper) ────────────────
IG_READONLY_USERNAME="your_readonly_ig_username"
IG_READONLY_PASSWORD="your_readonly_ig_password"
IG_SESSION_FILE="data/ig_readonly_session.json"

# ── Ingestion Layer — Trending Sources (optional) ─────────────────────────────
# YOUTUBE_API_KEY=""       # YouTube Data API v3 (free: 10K req/day)
# TELEGRAM_API_ID=""       # From https://my.telegram.org
# TELEGRAM_API_HASH=""     # From https://my.telegram.org

